# =============================================================================
# Plantilla de variables — MISMA lista y orden que .env.development y .env.production.
# Solo cambian los VALORES entre entornos; nunca agregues/quites claves en un
# archivo sin hacerlo en los tres.
#
# Uso en el VPS: el contenido completo va en el secret ENV_FILE del GitHub
# Environment (staging | production); el pipeline lo escribe como
# /opt/payroll/<entorno>/.env.deploy (chmod 600). NO subas valores reales a Git.
# Genera secretos con:  openssl rand -base64 32
#
# Reglas:
#  - Los hosts de infraestructura son los nombres de servicio del compose
#    (postgres, rabbitmq), igual que en desarrollo. No los cambies.
#  - Las credenciales de RabbitMQ se escriben UNA sola vez (RABBITMQ_DEFAULT_USER /
#    RABBITMQ_DEFAULT_PASS, con las que se crea el contenedor) y SERVICE_MESSAGING_URL
#    se deriva de ellas con ${...}. Deben ir ANTES de la URL (Compose solo expande
#    variables definidas antes en el archivo). Usa contraseñas en hex: un @ : / #
#    en la clave rompería la URL.
#  - PORT lo fija el compose por proceso (3000 web / 3001 worker); se deja aquí
#    solo para que la lista sea idéntica a la de desarrollo.
#  - Los comentarios van en su propia línea (nunca al final de un valor).
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
NODE_ENV=production
FORCE_SECURE=true
PORT=3000
API_VERSION=1
API_HOST="https://api-staging.tu-dominio.com"

# --- Mensajería (RabbitMQ del compose; para Azure: MESSAGING_PROVIDER=servicebus
# --- y SERVICE_MESSAGING_URL = cadena de conexión de Service Bus) -----------------
MESSAGING_PROVIDER=rabbitmq
RABBITMQ_DEFAULT_USER=payroll
RABBITMQ_DEFAULT_PASS=CAMBIAR_password_rabbit
SERVICE_MESSAGING_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672
PAYROLL_JOBS_QUEUE=payroll-jobs
LIQUIDATION_JOBS_QUEUE=liquidation-jobs
PAYROLL_STATUS_QUEUE=payroll-status

# --- Worker / cron -------------------------------------------------------------
EXECUTE_PAYROLL_CRON=true
PAYROLL_SCHEDULE_CRON=0 */2 * * * *
TZ=America/Bogota

# --- Frontend (origen permitido por CORS) -------------------------------------
FRONTEND_URL="https://app-staging.tu-dominio.com"

# --- PostgreSQL (el contenedor se crea con estas credenciales la 1ª vez) --------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_password_postgres
POSTGRES_DB=dbPayroll
POSTGRES_SSL=false

# --- Auth (secretos DISTINTOS por entorno, nunca "mysecretkey") -----------------
JWT_SECRET=CAMBIAR
JWT_EXPIRATION=15m
REFRESH_EXPIRATION=7d
JWT_ACCESS_TOKEN_SECRET=CAMBIAR
JWT_REFRESH_TOKEN_SECRET=CAMBIAR
JWT_ACCESS_TOKEN_EXPIRATION_MS=600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=3600000

# --- Logs ----------------------------------------------------------------------
USE_JSON_LOGGER=true
DEBUG=false

# --- Correo --------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_USER=CAMBIAR
MAIL_PASS=CAMBIAR
MAIL_PORT=465
MAIL_TRANSPORT=smtps://USUARIO:PASSWORD@smtp.gmail.com:465

# --- PgAdmin (no hay servicio pgadmin en el compose VPS; se conserva por paridad) --
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=CAMBIAR

# =============================================================================
# Overrides OPCIONALES de recursos (solo VPS; dejarlos comentados no altera la
# lista de claves). Los defaults del compose están pensados para 1 GB de RAM
# + 4 GB de swap. En un servidor más grande (producción) descomenta y ajusta,
# p. ej. para 8 GB:
# =============================================================================
#POSTGRES_MEM_LIMIT=1g
#PG_SHARED_BUFFERS=512MB
#PG_EFFECTIVE_CACHE_SIZE=2GB
#PG_WORK_MEM=8MB
#PG_MAINTENANCE_WORK_MEM=128MB
#PG_MAX_CONNECTIONS=100
#REDIS_MEM_LIMIT=256m
#REDIS_MAXMEMORY=192mb
#RABBITMQ_MEM_LIMIT=768m
#RABBITMQ_MEM_WATERMARK=512MiB
#API_MEM_LIMIT=1g
#API_NODE_HEAP=768
#WORKER_MEM_LIMIT=1g
#WORKER_NODE_HEAP=768
